{
  "manifest_version": 3,
  "name": "NetWatch: Family AI Guardian",
  "version": "3.0.0",
  "description": "Family safety guardian & parental command center. Tracks children's online activity, enforces web rules & bedtimes, and shields private info in AI prompts.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/16x16.png",
      "24": "images/24x24.png",
      "32": "images/32x32.png",
      "48": "images/48x48.png",
      "128": "images/128x128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://openai.com/*",
        "*://*.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://character.ai/*",
        "*://*.character.ai/*",
        "*://janitorai.com/*",
        "*://*.janitorai.com/*",
        "*://replika.com/*",
        "*://*.replika.com/*",
        "*://replika.ai/*",
        "*://*.replika.ai/*",
        "*://talkie-ai.com/*",
        "*://*.talkie-ai.com/*",
        "*://crushon.ai/*",
        "*://*.crushon.ai/*",
        "*://civitai.com/*",
        "*://*.civitai.com/*",
        "*://perchance.org/*",
        "*://*.perchance.org/*",
        "*://poe.com/*",
        "*://*.poe.com/*",
        "*://deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://copilot.microsoft.com/*",
        "*://brainly.com/*",
        "*://*.brainly.com/*",
        "*://coursehero.com/*",
        "*://*.coursehero.com/*",
        "*://spicychat.ai/*",
        "*://*.spicychat.ai/*",
        "*://chai.ml/*",
        "*://*.chai.ml/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "all_frames": true,
      "js": ["prompt_guardian.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blacklist.txt",
        "blocked.html",
        "blocked.js",
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "images/16x16.png",
    "24": "images/24x24.png",
    "32": "images/32x32.png",
    "48": "images/48x48.png",
    "128": "images/128x128.png"
  }
}
